# 汇总去重（generate_summary.py）读取的配置。
# 复制为 .env 后填入自己的值：cp .env.example .env
# .env 已在 .gitignore 中，不会提交；密钥绝不写入输出文件。

# OpenAI 兼容接口地址（不带末尾 /chat/completions）。
# 默认 DeepSeek 官方；也可指向本地 vLLM 等自部署端点，例如 http://127.0.0.1:8000/v1
DEDUP_API_BASE=https://api.deepseek.com

# 模型名。注意：即使关闭 thinking，部分模型仍会输出推理 token，
# generate_summary.py 已把 max_tokens 放宽到 16384，端点需支持该上限。
DEDUP_MODEL=deepseek-v4-flash

# API 密钥。未提供时脚本直接报错，不会降级为仅同名去重。
# 也可改用 DEEPSEEK_API_KEY（两种写法二选一即可）。
DEDUP_API_KEY=

# 可选：语义去重的并发请求数（默认 4）。端点扛不住时可调小。
# WR_DEDUP_CONCURRENCY=4

# AI 筛选（web/screen_update.py）默认复用上面的 DEDUP_* 端点。
# 需要给筛选单独换端点/模型时才写这三行（模型需支持图片输入，如 GLM-5.3-Flash）：
# SCREEN_API_BASE=http://127.0.0.1:8000/v1
# SCREEN_MODEL=zai-org/GLM-5.3-Flash
# SCREEN_API_KEY=

# 可选：AI 筛选的抓取/识别并发数（默认 10，范围 1-20）。
# WR_SCREEN_CONCURRENCY=10
